<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the phone, not even through Google's cloud backup or a device-to-device transfer: rules,
    usage and the PIN stay where they were created. Excluding the whole domain is the privacy-first default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
