<?xml version="1.0" encoding="utf-8"?>
<!--
    The background of the launcher icon: near-black with the same four lights as the dark look's aurora (violet, teal,
    magenta, blue). Each light is a radial gradient over the whole canvas that fades to nothing.
-->
