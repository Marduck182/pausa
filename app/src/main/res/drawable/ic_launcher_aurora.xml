                <item android:color="#80C040A0" android:offset="0.0" />
                <item android:color="#00C040A0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
