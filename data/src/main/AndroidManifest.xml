<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Package visibility without QUERY_ALL_PACKAGES: Pausa only needs to see apps that have a launcher icon,
        which is exactly what a person would pick from their home screen. It cannot see the rest.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
